# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/

# Testing & type-checking caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
# `pytest-xdist` (`-n auto`, added 2026-08-30) makes `coverage.py` write
# one file per worker before combining them -- `.coverage.<host>.<pid>.
# <random>`, which the bare `.coverage` entry above does not match.
# Found the same day `-n auto` landed: `git add -A` picked up a batch of
# these as untracked files.
.coverage.*
htmlcov/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code agent worktrees -- ephemeral, local git worktrees spawned
# for isolated subagent work; each is its own nested git repo, not
# content this repository should ever track.
.claude/worktrees/
